{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "typeRoots": ["./node_modules/@types", "./server/types"]
  },
  "include": ["server/**/*", "server/types/**/*", "*.ts"]
}
